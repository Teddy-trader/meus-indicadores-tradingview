
//@version=6
indicator("Falso de LTA & LTB", overlay=true, max_lines_count=500)

left      = input.int(20,  "Pivot Left",  minval=1)
right     = input.int(20,  "Pivot Right", minval=1)
horas     = input.int(168, "Janela (horas)", minval=1)
maxLinhas = input.int(3,   "Máx. linhas por pivot", minval=1, maxval=10)
colLTB    = input.color(#ef5350, "Cor LTB (topos)")
colLTA    = input.color(#26a69a, "Cor LTA (fundos)")

int MSJanela = horas * 60 * 60 * 1000

ph = ta.pivothigh(high, left, right)
pl = ta.pivotlow(low,  left, right)

var float[] phPrices = array.new_float()
var int[]   phBars   = array.new_int()
var int[]   phTimes  = array.new_int()
var float[] plPrices = array.new_float()
var int[]   plBars   = array.new_int()
var int[]   plTimes  = array.new_int()

if not na(ph)
    int   pBar   = bar_index[right]
    float pPrice = ph
    int   pTime  = time[right]
    if (timenow - pTime) <= MSJanela
        bool dup = false
        if array.size(phBars) > 0
            for i = 0 to array.size(phBars) - 1
                if array.get(phBars, i) == pBar
                    dup := true
                    break
        if not dup
            array.push(phPrices, pPrice)
            array.push(phBars,   pBar)
            array.push(phTimes,  pTime)

if not na(pl)
    int   pBar   = bar_index[right]
    float pPrice = pl
    int   pTime  = time[right]
    if (timenow - pTime) <= MSJanela
        bool dup = false
        if array.size(plBars) > 0
            for i = 0 to array.size(plBars) - 1
                if array.get(plBars, i) == pBar
                    dup := true
                    break
        if not dup
            array.push(plPrices, pPrice)
            array.push(plBars,   pBar)
            array.push(plTimes,  pTime)

// FIX: limita acesso ao buffer histórico disponível
isLivre(bA, pA, bB, pB) =>
    bool  livre    = true
    float slope    = float(pB - pA) / float(bB - bA)
    int   distA    = bar_index - bA
    int   span     = bB - bA
    // spanSafe: nunca ultrapassa o buffer disponível (bar_index - 1 barras atrás max)
    int spanSafe = math.min(span - 1, distA - 1, bar_index - 1)
    if spanSafe >= 1
        for step = 1 to spanSafe
            int k = math.min(distA - step, bar_index - 1)
            if k >= 0 and k < bar_index
                float proj  = pA + slope * float(step)
                float bHigh = math.max(open[k], close[k])
                float bLow  = math.min(open[k], close[k])
                if proj >= bLow and proj <= bHigh
                    livre := false
                    break
    livre

contaRomps(bB, pB, slope, isLTB) =>
    int  n  = 0
    int  dB = bar_index - bB
    if dB >= 2
        // limita também contaRomps ao buffer disponível
        int  dBSafe = math.min(dB, bar_index - 1)
        float proj0 = pB + slope * 1.0
        bool  prev  = isLTB ? close[dBSafe - 1] > proj0 : close[dBSafe - 1] < proj0
        for k = dBSafe - 2 to 0
            float proj = pB + slope * float(dBSafe - k)
            bool  cur  = isLTB ? close[k] > proj : close[k] < proj
            if cur != prev
                n   += 1
            prev := cur
    n

var line[]  activeLines = array.new_line()
var float[] lineSlopes  = array.new_float()
var float[] lineBase    = array.new_float()
var int[]   lineBaseBar = array.new_int()
var int[]   lineRomps   = array.new_int()
var bool[]  lineLado    = array.new_bool()
var bool[]  lineIsLTB   = array.new_bool()

if barstate.islast
    if array.size(activeLines) > 0
        for i = 0 to array.size(activeLines) - 1
            line.delete(array.get(activeLines, i))
    array.clear(activeLines)
    array.clear(lineSlopes)
    array.clear(lineBase)
    array.clear(lineBaseBar)
    array.clear(lineRomps)
    array.clear(lineLado)
    array.clear(lineIsLTB)

    int nH = array.size(phPrices)
    if nH >= 2
        for i = 0 to nH - 2
            float pA = array.get(phPrices, i)
            int   bA = array.get(phBars,   i)
            int   tA = array.get(phTimes,  i)
            if (timenow - tA) <= MSJanela
                int count = 0
                for j = i + 1 to nH - 1
                    if count >= maxLinhas
                        break
                    float pB = array.get(phPrices, j)
                    int   bB = array.get(phBars,   j)
                    if pA > pB and bA < bB
                        if isLivre(bA, pA, bB, pB)
                            float sl = float(pB - pA) / float(bB - bA)
                            int   r  = contaRomps(bB, pB, sl, true)
                            if r < 2
                                float proj = pB + sl * float(bar_index - bB)
                                ln = line.new(bA, pA, bB, pB,
                                     xloc=xloc.bar_index, color=colLTB, width=2,
                                     style=line.style_dotted, extend=extend.right)
                                array.push(activeLines, ln)
                                array.push(lineSlopes,  sl)
                                array.push(lineBase,    pB)
                                array.push(lineBaseBar, bB)
                                array.push(lineRomps,   r)
                                array.push(lineLado,    close > proj)
                                array.push(lineIsLTB,   true)
                                count += 1

    int nL = array.size(plPrices)
    if nL >= 2
        for i = 0 to nL - 2
            float pA = array.get(plPrices, i)
            int   bA = array.get(plBars,   i)
            int   tA = array.get(plTimes,  i)
            if (timenow - tA) <= MSJanela
                int count = 0
                for j = i + 1 to nL - 1
                    if count >= maxLinhas
                        break
                    float pB = array.get(plPrices, j)
                    int   bB = array.get(plBars,   j)
                    if pA < pB and bA < bB
                        if isLivre(bA, pA, bB, pB)
                            float sl = float(pB - pA) / float(bB - bA)
                            int   r  = contaRomps(bB, pB, sl, false)
                            if r < 2
                                float proj = pB + sl * float(bar_index - bB)
                                ln = line.new(bA, pA, bB, pB,
                                     xloc=xloc.bar_index, color=colLTA, width=2,
                                     style=line.style_dotted, extend=extend.right)
                                array.push(activeLines, ln)
                                array.push(lineSlopes,  sl)
                                array.push(lineBase,    pB)
                                array.push(lineBaseBar, bB)
                                array.push(lineRomps,   r)
                                array.push(lineLado,    close < proj)
                                array.push(lineIsLTB,   false)
                                count += 1

if array.size(activeLines) > 0 and not barstate.islast
    int i = 0
    while i < array.size(activeLines)
        ln         = array.get(activeLines, i)
        float sl   = array.get(lineSlopes,  i)
        float pb   = array.get(lineBase,    i)
        int   bb   = array.get(lineBaseBar, i)
        bool isLTB = array.get(lineIsLTB,   i)
        float proj = pb + sl * float(bar_index - bb)
        bool  lado = isLTB ? close > proj : close < proj
        bool  antes = array.get(lineLado,   i)
        if lado != antes
            int r = array.get(lineRomps, i) + 1
            array.set(lineRomps, i, r)
            if r >= 2
                line.delete(ln)
                array.remove(activeLines, i)
                array.remove(lineSlopes,  i)
                array.remove(lineBase,    i)
                array.remove(lineBaseBar, i)
                array.remove(lineRomps,   i)
                array.remove(lineLado,    i)
                array.remove(lineIsLTB,   i)
                continue
        array.set(lineLado, i, lado)
        i += 1
